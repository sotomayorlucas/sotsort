+// --- SotSort (agregado para la comparación; no es parte del artefacto original) ---
+// Mismo presupuesto de bytes que reserva almost_inplace_powersort (page_buf + punteros).
+template <typename T> static size_t vm_bytes(size_t n) {
+    const double target_p = sqrt((double)sizeof(T *) * 4 * n / (sizeof(T) * (log2(n) + 7)));
+    const size_t log_n = 33 - __builtin_clz(n + 1), log_p = 33 - __builtin_clz((int)target_p + 1),
+                 co_log_p = log_n - log_p + 1, max_runs = log_n + 4, extra_pages = max_runs + 3,
+                 page_buf_sz = extra_pages << log_p, free_page_buf_sz = extra_pages + 1, ptr_buf_sz = 4 << co_log_p;
+    return sizeof(T) * page_buf_sz + sizeof(T *) * (free_page_buf_sz + ptr_buf_sz);
+}
+template <typename T> static void sot_with(T *v, T *ep, size_t bytes) {
+    sot::Options o; o.threads = 1; o.probe = false; o.shortcuts = false; o.max_bytes = bytes;
+    sot::stable_sort_fast(v, size_t(ep - v), std::less<T>(), o);
+}
+template <typename T> static void sot4_with(T *v, T *ep, size_t bytes) {
+    sot4::Options o; o.threads = 1; o.probe = false; o.shortcuts = false; o.max_bytes = bytes;
+    sot4::stable_sort_fast(v, size_t(ep - v), std::less<T>(), o);
+}
+template <typename T> static void my_sot4vm(T *v, T *ep) { sot4_with(v, ep, vm_bytes<T>(ep - v)); }
+template <typename T> static void my_sot4half(T *v, T *ep) { sot4_with(v, ep, sizeof(T) * size_t(ep - v) / 2); }
+template <typename T> static void my_sot0(T *v, T *ep) { sot_with(v, ep, 0); }
+template <typename T> static void my_sotvm(T *v, T *ep) { sot_with(v, ep, vm_bytes<T>(ep - v)); }
+template <typename T> static void my_sothalf(T *v, T *ep) { sot_with(v, ep, sizeof(T) * size_t(ep - v) / 2); }
+template <typename T> static void my_sotfull(T *v, T *ep) { sot_with(v, ep, sizeof(T) * size_t(ep - v)); }
+
